---
import BaseLayout from "../layouts/BaseLayout.astro";
import StarRating from "../components/StarRating.astro";
import Divider from "../components/Divider.astro";
import Heatmap from "../components/Heatmap.astro";
import { getStats } from "../lib/stats";
import { getSubjectBreakdown } from "../lib/enrichment";
import { authorSlug } from "../lib/authors";
import { withBase } from "../lib/url";

const stats = await getStats();
const subjects = await getSubjectBreakdown();
const maxYear = Math.max(1, ...stats.byYear.map((y) => y.count));
const maxHist = Math.max(1, ...stats.ratingHistogram.map((h) => h.count));
const maxAuthor = Math.max(1, ...stats.topAuthors.map((a) => a.count));
const maxSubject = Math.max(1, ...subjects.map((s) => s.count));

const bigNumbers = [
  { label: "Books read", value: stats.totalRead },
  { label: "Reviews written", value: stats.totalReviewed },
  { label: "Average rating", value: stats.avgRating.toFixed(2) },
];
if (stats.totalPages > 0)
  bigNumbers.push({ label: "Pages", value: stats.totalPages.toLocaleString() });

// Pace: streaks / dry spells / busiest month, from computeStats().
const MONTHS_SHORT = [
  "Jan", "Feb", "Mar", "Apr", "May", "Jun",
  "Jul", "Aug", "Sep", "Oct", "Nov", "Dec",
];
function fmtMonthKey(key: string): string {
  const [y, m] = key.split("-").map(Number);
  return `${MONTHS_SHORT[m - 1]} ${y}`;
}
const pace = stats.pace;
const paceNumbers: { value: string; label: string; sub?: string }[] = [];
if (pace.longestStreak && pace.longestStreak.months > 1) {
  paceNumbers.push({
    value: `${pace.longestStreak.months} mo`,
    label: "Longest streak",
    sub: `${fmtMonthKey(pace.longestStreak.from)} – ${fmtMonthKey(pace.longestStreak.to)}`,
  });
}
paceNumbers.push({
  value: `${pace.currentStreak} mo`,
  label: "Current streak",
  sub: "consecutive months with a book",
});
if (pace.longestGap && pace.longestGap.days > 0) {
  paceNumbers.push({
    value: `${pace.longestGap.days} days`,
    label: "Longest dry spell",
    sub: `${pace.longestGap.from.slice(0, 7)} → ${pace.longestGap.to.slice(0, 7)}`,
  });
}
if (pace.busiestMonth) {
  paceNumbers.push({
    value: String(pace.busiestMonth.count),
    label: "Busiest month",
    sub: `${MONTHS_SHORT[pace.busiestMonth.month]} ${pace.busiestMonth.year}`,
  });
}
---

<BaseLayout title="Stats" description="Reading stats and year in books.">
  <section class="measure">
    <p class="eyebrow">By the numbers</p>
    <h1>Reading Stats</h1>
    <p class="meta">
      Across reviews and the shelf — every book counted, the receipts kept.
    </p>
  </section>

  <section class="bignums measure">
    {
      bigNumbers.map((n) => (
        <div class="bignum">
          <span class="bignum__value">{n.value}</span>
          <span class="bignum__label">{n.label}</span>
        </div>
      ))
    }
  </section>

  <Divider />

  <section class="measure block">
    <h2>Ratings given</h2>
    <p class="meta">Click a row to see those books on the <a href={withBase("/shelf")}>shelf</a>.</p>
    <div class="hist">
      {
        stats.ratingHistogram
          .slice()
          .reverse()
          .map((h) => {
            const Tag = h.count > 0 ? "a" : "div";
            const props =
              h.count > 0
                ? {
                    href: withBase(`/shelf?rating=${h.rating}`),
                    title: `See the ${h.rating}★ books on the shelf`,
                  }
                : {};
            return (
              <Tag class="hist__row" {...props}>
                <span class="hist__label">
                  <StarRating rating={h.rating} size="0.8rem" />
                </span>
                <span class="hist__bar">
                  <span
                    class="hist__fill"
                    style={`width:${(h.count / maxHist) * 100}%`}
                  />
                </span>
                <span class="hist__count">{h.count}</span>
              </Tag>
            );
          })
      }
    </div>
  </section>

  <section class="measure block">
    <h2>Year in books</h2>
    <p class="meta">Click a year for its full wrap-up.</p>
    <div class="years">
      {
        stats.byYear.map((y) => (
          <div class="year">
            <div class="year__head">
              <a class="year__num" href={withBase(`/year/${y.year}`)}>{y.year}</a>
              <span class="meta">
                {y.count} books · avg {y.avgRating.toFixed(1)}★
                {y.pages > 0 && <> · {y.pages.toLocaleString()} pp</>}
              </span>
            </div>
            <a class="year__bar" href={withBase(`/year/${y.year}`)} aria-label={`${y.year} in books`}>
              <span class="year__fill" style={`width:${(y.count / maxYear) * 100}%`} />
            </a>
          </div>
        ))
      }
      {
        stats.unknownYear > 0 && (
          <p class="meta" style="margin-top:var(--space-3)">
            + {stats.unknownYear} read with no recorded date.
          </p>
        )
      }
    </div>
  </section>

  {
    stats.monthly.length > 0 && (
      <section class="measure block">
        <h2>Books by month</h2>
        <p class="meta">
          When the reading happens. Darker = more books; click a month to jump
          to it in the <a href={withBase("/timeline")}>timeline</a>.
        </p>
        <Heatmap
          monthly={stats.monthly}
          maxMonth={stats.maxMonth}
          hrefFor={(year, m) =>
            withBase(`/timeline#${year}-${String(m + 1).padStart(2, "0")}`)}
        />
      </section>
    )
  }

  {
    subjects.length > 0 && (
      <section class="measure block">
        <h2>Common threads</h2>
        <p class="meta">
          What the library keeps returning to — subjects via Open Library
          (<code>npm run enrich</code>).
        </p>
        <div class="authors">
          {subjects.map((s) => (
            <div class="author">
              <span class="author__name">{s.subject}</span>
              <span class="author__bar">
                <span
                  class="author__fill author__fill--night"
                  style={`width:${(s.count / maxSubject) * 100}%`}
                />
              </span>
              <span class="author__count">{s.count}</span>
            </div>
          ))}
        </div>
      </section>
    )
  }

  {
    paceNumbers.length > 0 && (
      <section class="measure block">
        <h2>Pace</h2>
        <div class="bignums">
          {paceNumbers.map((n) => (
            <div class="bignum">
              <span class="bignum__value">{n.value}</span>
              <span class="bignum__label">{n.label}</span>
              {n.sub && <span class="bignum__sub">{n.sub}</span>}
            </div>
          ))}
        </div>
      </section>
    )
  }

  {
    stats.topAuthors.length > 0 && (
      <section class="measure block">
        <h2>Most-read authors</h2>
        <p class="meta">
          Click through, or see <a href={withBase("/authors")}>every author</a>.
        </p>
        <div class="authors">
          {stats.topAuthors.map((a) => (
            <a class="author" href={withBase(`/authors/${authorSlug(a.author)}`)}>
              <span class="author__name">{a.author}</span>
              <span class="author__bar">
                <span
                  class="author__fill"
                  style={`width:${(a.count / maxAuthor) * 100}%`}
                />
              </span>
              <span class="author__count">{a.count}</span>
            </a>
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .block {
    margin-top: var(--space-7);
  }
  .bignums {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: var(--space-5);
    margin-top: var(--space-5);
  }
  .bignum {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .bignum__value {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    line-height: 1;
    color: var(--color-night);
  }
  .bignum__label {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .bignum__sub {
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  /* histogram */
  .hist {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }
  .hist__row {
    display: grid;
    grid-template-columns: 5.5em 1fr 2.5em;
    align-items: center;
    gap: var(--space-3);
  }
  a.hist__row {
    color: inherit;
  }
  a.hist__row:hover {
    text-decoration: none;
  }
  a.hist__row:hover .hist__fill {
    filter: brightness(1.12);
  }
  a.hist__row:hover .hist__count {
    color: var(--color-accent);
  }
  .hist__bar,
  .year__bar,
  .author__bar {
    background: var(--color-faint);
    border-radius: 999px;
    height: 12px;
    overflow: hidden;
  }
  .hist__fill {
    display: block;
    height: 100%;
    background: var(--color-star);
    border-radius: 999px;
  }
  .hist__count,
  .author__count {
    font-size: var(--text-sm);
    color: var(--color-muted);
    text-align: right;
  }

  /* years */
  .years {
    margin-top: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .year__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-3);
    margin-bottom: 4px;
  }
  .year__num {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
    color: var(--color-ink);
  }
  a.year__num:hover {
    color: var(--color-accent);
    text-decoration: none;
  }
  a.year__bar {
    display: block;
  }
  a.year__bar:hover .year__fill {
    filter: brightness(1.12);
  }
  .year__fill {
    display: block;
    height: 100%;
    background: var(--color-night);
    border-radius: 999px;
  }

  /* authors */
  .authors {
    margin-top: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .author {
    display: grid;
    grid-template-columns: 12em 1fr 2.5em;
    align-items: center;
    gap: var(--space-3);
    color: inherit;
  }
  a.author:hover {
    text-decoration: none;
  }
  a.author:hover .author__name {
    color: var(--color-accent);
  }
  a.author:hover .author__fill {
    filter: brightness(1.12);
  }
  .author__name {
    font-size: var(--text-sm);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .author__fill {
    display: block;
    height: 100%;
    background: var(--color-accent);
    border-radius: 999px;
  }
  .author__fill--night {
    background: var(--color-night);
  }
  @media (max-width: 32rem) {
    .author {
      grid-template-columns: 8em 1fr 2em;
    }
    .hist__row {
      grid-template-columns: 5em 1fr 2em;
    }
  }
</style>
