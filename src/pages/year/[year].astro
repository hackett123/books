---
// /year/<year> — the owner's "Year in Books" wrap-up. One page per year with
// at least one dated read, so past years (2025, …) backfill automatically.
// Friends get the same treatment at /friends/<slug>/year/<year>.
import BaseLayout from "../../layouts/BaseLayout.astro";
import YearInBooks, { type YearBook } from "../../components/YearInBooks.astro";
import { getReadBooks } from "../../lib/library";
import { withBase } from "../../lib/url";

export async function getStaticPaths() {
  const books = await getReadBooks();
  const years = [
    ...new Set(
      books
        .filter((b) => b.dateRead && !isNaN(b.dateRead.getTime()))
        .map((b) => b.dateRead!.getUTCFullYear())
    ),
  ].sort((a, b) => b - a);
  return years.map((year) => ({
    params: { year: String(year) },
    props: { year, years },
  }));
}

interface Props {
  year: number;
  years: number[];
}
const { year, years } = Astro.props;

const books: YearBook[] = (await getReadBooks())
  .filter((b) => b.dateRead && b.dateRead.getUTCFullYear() === year)
  .map((b) => ({
    title: b.title,
    author: b.author,
    rating: b.rating,
    cover: b.cover,
    href: b.href,
    external: b.external,
    dateRead: b.dateRead!,
    slug: b.slug,
  }));
---

<BaseLayout
  title={`${year} in books`}
  description={`A year of reading: the ${books.length} books of ${year}.`}
>
  <section class="measure">
    <p class="eyebrow"><a href={withBase("/stats")}>Stats</a> ›</p>
    <h1>{year} in books</h1>
  </section>

  <YearInBooks year={year} years={years} books={books} basePath="/year" linkAuthors />
</BaseLayout>
