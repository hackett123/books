---
import BaseLayout from "../layouts/BaseLayout.astro";
import BookCover from "../components/BookCover.astro";
import MonthStrip from "../components/MonthStrip.astro";
import RecentActivity from "../components/RecentActivity.astro";
import ReviewCard from "../components/ReviewCard.astro";
import { getActivityWindow } from "../lib/activity";
import { getPublishedReviews, excerpt } from "../lib/reviews";
import { getStats } from "../lib/stats";
import { withBase } from "../lib/url";
import shelves from "../data/shelves.json";

// Homepage = the reading room: what's new, what's in hand, the year's pulse.
// The full library lives on /shelf.
const { hours, events } = getActivityWindow();
const updatesEyebrow =
  { 24: "Since yesterday", [24 * 7]: "This week", [24 * 30]: "This month" }[
    hours
  ] ?? "Lately";

const reading = (shelves.currentlyReading ?? []) as Array<{
  title: string;
  author: string;
  cover?: string;
  url?: string;
  dateAdded?: string;
}>;
const toReadCount = (shelves.toRead ?? []).length;

function fmtStarted(iso?: string): string | undefined {
  if (!iso) return undefined;
  return new Date(iso).toLocaleDateString("en-US", {
    timeZone: "UTC", // calendar dates at UTC midnight; don't shift
    month: "short",
    day: "numeric",
  });
}

const stats = await getStats();
const buildYear = new Date().getUTCFullYear();
const yearCount = stats.byYear.find((y) => y.year === buildYear)?.count ?? 0;
const streak = stats.pace.currentStreak;

const latest = (await getPublishedReviews())[0];
---

<BaseLayout
  description="What I'm reading right now, the latest shelf activity, and the year's reading pulse."
>
  {/* The shelf grid used to live at "/" — send old filter bookmarks
      (e.g. /?rating=4 from /stats history) on to /shelf. */}
  <script is:inline data-shelf={withBase("/shelf")}>
    (() => {
      const p = new URLSearchParams(location.search);
      if (p.has("rating") || p.has("reviewed") || p.has("sort"))
        location.replace(
          document.currentScript.dataset.shelf + location.search
        );
    })();
  </script>

  <section class="intro measure">
    <p class="eyebrow">The reading room</p>
    <h1 class="visually-hidden">Marginalia — the reading room</h1>
    <p class="intro__lede">
      What's moving here lately — the full library lives on the
      <a href={withBase("/shelf")}>shelf</a>.
    </p>
  </section>

  {
    events.length > 0 ? (
      <RecentActivity
        hours={hours}
        eyebrow={updatesEyebrow}
        ariaLabel="Recent reading updates"
      />
    ) : (
      <p class="meta measure quiet">All quiet since the last sync.</p>
    )
  }

  <section class="reading measure" aria-label="Currently reading">
    <h2 class="eyebrow">Now reading</h2>
    {
      reading.length > 0 ? (
        <ul class="reading__grid">
          {reading.map((b) => {
            const started = fmtStarted(b.dateAdded);
            return (
              <li class="reading__card">
                {b.url ? (
                  <a
                    class="reading__cover"
                    href={b.url}
                    rel="nofollow noopener"
                    target="_blank"
                  >
                    <BookCover cover={b.cover} title={b.title} author={b.author} width={110} />
                  </a>
                ) : (
                  <span class="reading__cover">
                    <BookCover cover={b.cover} title={b.title} author={b.author} width={110} />
                  </span>
                )}
                <div class="reading__meta">
                  {b.url ? (
                    <a
                      class="reading__title"
                      href={b.url}
                      rel="nofollow noopener"
                      target="_blank"
                    >
                      {b.title}
                    </a>
                  ) : (
                    <span class="reading__title">{b.title}</span>
                  )}
                  <span class="reading__author">{b.author}</span>
                  {started && <span class="reading__started">Started {started}</span>}
                </div>
              </li>
            );
          })}
        </ul>
      ) : (
        <p class="meta">Between books at the moment.</p>
      )
    }
    {
      toReadCount > 0 && (
        <p class="meta reading__pile">
          <a href={withBase("/to-read")}>
            {toReadCount} waiting in the pile →
          </a>
        </p>
      )
    }
  </section>

  <section class="year measure" aria-label="The year so far">
    <h2 class="eyebrow">The year so far</h2>
    <div class="year__nums">
      {
        yearCount > 0 ? (
          <a class="bignum" href={withBase(`/year/${buildYear}`)}>
            <span class="bignum__value">{yearCount}</span>
            <span class="bignum__label">books in {buildYear}</span>
          </a>
        ) : (
          <div class="bignum">
            <span class="bignum__value">{yearCount}</span>
            <span class="bignum__label">books in {buildYear}</span>
          </div>
        )
      }
      <div class="bignum">
        <span class="bignum__value">{streak} mo</span>
        <span class="bignum__label">reading streak</span>
      </div>
    </div>
    <div class="year__strip">
      <MonthStrip
        monthly={stats.monthly}
        label="My last 12 months of reading"
        hrefFor={(year, month) =>
          withBase(`/timeline#${year}-${String(month + 1).padStart(2, "0")}`)
        }
      />
    </div>
    <p class="meta"><a href={withBase("/stats")}>Full stats →</a></p>
  </section>

  {
    latest && (
      <section class="latest measure" aria-label="Latest review">
        <h2 class="eyebrow">Latest review</h2>
        <ReviewCard
          slug={latest.id}
          href={withBase(`/reviews/${latest.id}`)}
          title={latest.data.title}
          author={latest.data.author}
          rating={latest.data.rating}
          cover={latest.data.cover}
          dateRead={latest.data.dateRead}
          excerpt={excerpt(latest.body)}
        />
        <p class="meta latest__all">
          <a href={withBase("/reviews")}>All reviews →</a>
        </p>
      </section>
    )
  }

  <p class="meta measure shelf-link">
    <a href={withBase("/shelf")}>Browse the full shelf →</a>
  </p>
</BaseLayout>

<style>
  .intro {
    margin-bottom: var(--space-5);
  }
  .intro__lede {
    font-size: var(--text-lg);
    color: var(--color-muted);
    max-width: 34rem;
  }
  .quiet {
    margin-bottom: var(--space-6);
  }

  /* now reading */
  .reading {
    margin-bottom: var(--space-7);
  }
  .reading__grid {
    list-style: none;
    margin: var(--space-3) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(20rem, 1fr));
    gap: var(--space-5);
  }
  .reading__card {
    display: flex;
    gap: var(--space-4);
    border: var(--hairline);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    padding: var(--space-4);
    box-shadow: var(--shadow-sm);
  }
  .reading__cover {
    flex: none;
    display: block;
    transition: transform var(--transition);
  }
  a.reading__cover:hover {
    transform: translateY(-3px);
  }
  .reading__meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    justify-content: center;
    min-width: 0;
  }
  .reading__title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
    color: var(--color-ink);
  }
  a.reading__title:hover {
    color: var(--color-accent);
    text-decoration: none;
  }
  .reading__author {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .reading__started {
    font-size: var(--text-xs);
    color: var(--color-muted);
  }
  .reading__pile {
    margin-top: var(--space-3);
  }

  /* the year so far */
  .year {
    margin-bottom: var(--space-7);
  }
  .year__nums {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: var(--space-5);
    margin: var(--space-3) 0 var(--space-4);
    max-width: 24rem;
  }
  .bignum {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  a.bignum {
    text-decoration: none;
  }
  a.bignum:hover .bignum__value {
    color: var(--color-accent);
  }
  .bignum__value {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    line-height: 1;
    color: var(--color-night);
    transition: color var(--transition);
  }
  .bignum__label {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .year__strip {
    max-width: 30rem;
    margin-bottom: var(--space-3);
  }

  /* latest review */
  .latest {
    margin-bottom: var(--space-7);
  }
  .latest__all {
    margin-top: var(--space-3);
  }

  .shelf-link {
    margin-top: var(--space-6);
  }
</style>
