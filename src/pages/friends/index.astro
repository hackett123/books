---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BookCover from "../../components/BookCover.astro";
import MonthStrip from "../../components/MonthStrip.astro";
import RecentActivity from "../../components/RecentActivity.astro";
import { getFriends, type Friend } from "../../lib/friends";
import { getReadBooks } from "../../lib/library";
import { compareWithFriend } from "../../lib/compare";
import { getRecommendations } from "../../lib/recommend";
import { getRecentActivity } from "../../lib/activity";
import { withBase } from "../../lib/url";

const friends = getFriends();

// Books-in-common count per friend, for the card stat line.
const mine = await getReadBooks();
const sharedCount = new Map(
  friends.map((f) => [f.slug, compareWithFriend(mine, f).shared.length])
);

// Books friends loved (4★+) that aren't in the library or the to-read pile.
const RECS_SHOWN = 18;
const recommendations = await getRecommendations();
const topRecs = recommendations.slice(0, RECS_SHOWN);

function fansLabel(rec: (typeof topRecs)[number]): string {
  return rec.fans
    .map((f) => `${f.name.split(" ")[0]} ${f.rating}★`)
    .join(" · ");
}

function fmtSynced(iso: string | null): string | undefined {
  if (!iso) return undefined;
  return new Date(iso).toLocaleDateString("en-US", {
    timeZone: "UTC",
    year: "numeric",
    month: "short",
    day: "numeric",
  });
}

// Each card leads with books: currently-reading first (badged "now"), then
// the latest finishes, up to COVERS_SHOWN covers total.
const COVERS_SHOWN = 6;
interface CardBook {
  title: string;
  author: string;
  cover?: string;
  url?: string;
  now: boolean;
}
function cardBooks(f: Friend): CardBook[] {
  const reading: CardBook[] = f.currentlyReading.map((b) => ({
    ...b,
    now: true,
  }));
  // Dated reads newest-first; undated ones (some shelves lack read dates)
  // trail in shelf order so the row never comes up empty.
  const finished: CardBook[] = f.read
    .slice()
    .sort(
      (a, b) => (b.dateRead?.getTime() ?? 0) - (a.dateRead?.getTime() ?? 0)
    )
    .map((b) => ({
      title: b.title,
      author: b.author,
      cover: b.cover,
      url: b.url,
      now: false,
    }));
  return [...reading, ...finished].slice(0, COVERS_SHOWN);
}

// Skip the "Lately" section outright on a quiet month.
const hasLately =
  getRecentActivity(24 * 30).filter((e) => e.slug).length > 0;
---

<BaseLayout
  title="Friends"
  description="What my friends are reading — current reads, recent finishes, and recommendations."
>
  <section class="measure">
    <p class="eyebrow">Reading alongside</p>
    <h1>Friends</h1>
    <p class="intro__lede">
      A peek at what friends are reading, from their public Goodreads shelves.
      See it laid over my own reading on the
      <a href={withBase("/timeline")}>timeline</a>.
    </p>
  </section>

  {
    friends.length === 0 ? (
      <p class="empty measure">
        No friends yet. Add Goodreads userIds to <code>src/data/friends.json</code>
        and run <code>npm run sync:friends</code>.
      </p>
    ) : (
      <div class="friends">
        {friends.map((f) => {
          const synced = fmtSynced(f.syncedAt);
          const shared = sharedCount.get(f.slug) ?? 0;
          const covers = cardBooks(f);
          return (
            <section class="fcard">
              <header>
                <h2 class="fcard__name">
                  <a href={withBase(`/friends/${f.slug}`)}>{f.name}</a>
                </h2>
                <p class="fcard__stats meta">
                  {f.stats.totalRead} books · avg {f.stats.avgRating.toFixed(2)}★
                  {shared > 0 && <> · {shared} in common</>}
                </p>
              </header>

              {covers.length > 0 && (
                <ul class="fcard__covers">
                  {covers.map((b) => {
                    const tip = `${b.title} — ${b.author}${b.now ? " (reading now)" : ""}`;
                    return (
                      <li class="fcard__book">
                        {b.url ? (
                          <a href={b.url} rel="nofollow noopener" target="_blank" title={tip}>
                            <BookCover cover={b.cover} title={b.title} author={b.author} width={52} />
                          </a>
                        ) : (
                          <span title={tip}>
                            <BookCover cover={b.cover} title={b.title} author={b.author} width={52} />
                          </span>
                        )}
                        {b.now && <span class="fcard__now">now</span>}
                      </li>
                    );
                  })}
                </ul>
              )}

              <div class="fcard__strip">
                <MonthStrip
                  monthly={f.stats.monthly}
                  size="compact"
                  label={`${f.name}'s last 12 months of reading`}
                  hrefFor={(year, month) =>
                    withBase(
                      `/timeline/${f.slug}#${year}-${String(month + 1).padStart(2, "0")}`
                    )
                  }
                />
              </div>

              <footer class="fcard__foot meta">
                <a href={withBase(`/friends/${f.slug}`)}>Full stats →</a>
                <a href={f.profileUrl} rel="nofollow noopener" target="_blank">
                  Goodreads ↗
                </a>
                {synced && <span>synced {synced}</span>}
              </footer>
            </section>
          );
        })}
      </div>
    )
  }

  {
    topRecs.length > 0 && (
      <section class="recs">
        <h2>From your friends</h2>
        <p class="meta">
          Books they rated 4★ or higher that aren't on your shelf or your{" "}
          <a href={withBase("/to-read")}>to-read pile</a>. The ones several
          friends loved come first.
        </p>
        <ul class="recs__grid">
          {topRecs.map((r) => (
            <li class="recs__item">
              <a href={r.url ?? "#"} class="recs__cover" rel="nofollow noopener" target="_blank">
                <BookCover cover={r.cover} title={r.title} author={r.author} width={110} />
              </a>
              <div class="recs__meta">
                <a href={r.url ?? "#"} class="recs__title" rel="nofollow noopener" target="_blank">
                  {r.title}
                </a>
                <span class="recs__author">{r.author}</span>
                <span class="recs__fans">{fansLabel(r)}</span>
              </div>
            </li>
          ))}
        </ul>
        {recommendations.length > topRecs.length && (
          <p class="meta">
            …and {recommendations.length - topRecs.length} more across their
            shelves.
          </p>
        )}
      </section>
    )
  }

  {
    hasLately && (
      <section class="lately">
        <h2>Lately</h2>
        <p class="meta">What they've started, finished, and rated in the last month.</p>
        <RecentActivity
          hours={24 * 30}
          friendsOnly
          limit={10}
          eyebrow=""
          ariaLabel="Friends' reading updates from the last month"
        />
      </section>
    )
  }
</BaseLayout>

<style>
  .intro__lede {
    font-size: var(--text-lg);
    color: var(--color-muted);
    max-width: 34rem;
    margin-bottom: var(--space-6);
  }
  .friends {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(20rem, 1fr));
    gap: var(--space-5);
  }
  .fcard {
    border: var(--hairline);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    padding: var(--space-5);
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .fcard__name {
    font-size: var(--text-xl);
    margin: 0;
  }
  .fcard__name a {
    color: var(--color-ink);
  }
  .fcard__name a:hover {
    color: var(--color-accent);
    text-decoration: none;
  }
  .fcard__stats {
    margin: 2px 0 0;
  }

  /* cover row: currently reading (badged) + recent finishes */
  .fcard__covers {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  .fcard__book {
    position: relative;
  }
  .fcard__now {
    position: absolute;
    top: -6px;
    right: -6px;
    font-size: 0.55rem;
    font-weight: var(--weight-medium);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    line-height: 1;
    padding: 2px 5px;
    border-radius: 999px;
    background: var(--color-accent);
    color: var(--color-bg);
    box-shadow: 0 0 0 2px var(--color-bg);
  }

  /* last-12-months strip (cells live in MonthStrip) */
  .fcard__strip {
    margin-top: auto; /* pins strip + footer to the card bottom */
  }

  .fcard__foot {
    display: flex;
    gap: var(--space-4);
    align-items: center;
    padding-top: var(--space-3);
    border-top: var(--hairline);
  }
  .fcard__foot span {
    margin-left: auto;
  }
  .empty {
    color: var(--color-muted);
  }

  /* from-your-friends recommendations */
  .recs,
  .lately {
    margin-top: var(--space-7);
  }
  .recs__grid {
    list-style: none;
    margin: var(--space-4) 0 var(--space-4);
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
    gap: var(--space-6) var(--space-5);
  }
  .recs__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .recs__cover {
    display: block;
    transition: transform var(--transition);
  }
  .recs__cover:hover {
    transform: translateY(-3px);
  }
  .recs__meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .recs__title {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    line-height: var(--leading-snug);
    color: var(--color-ink);
    align-self: start;
  }
  .recs__title:hover {
    color: var(--color-accent);
    text-decoration: none;
  }
  .recs__author {
    font-size: var(--text-xs);
    color: var(--color-muted);
  }
  .recs__fans {
    font-size: var(--text-xs);
    color: var(--color-accent);
  }
  .lately :global(.updates) {
    margin-top: var(--space-4);
    margin-bottom: 0;
  }
</style>
