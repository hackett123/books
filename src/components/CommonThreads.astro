---
// The "Common threads" subject chart, shared by /stats and /friends/<slug>.
// Each bar is a disclosure button: clicking it unfolds the books behind that
// subject, so the number on the bar and the list underneath always agree.
import BookCover from "./BookCover.astro";
import StarRating from "./StarRating.astro";
import type { SubjectCount } from "../lib/enrichment";

interface Props {
  threads: SubjectCount[];
}
const { threads } = Astro.props;
const max = Math.max(1, ...threads.map((t) => t.count));

// Ids tie each button to the list it controls (aria-controls).
const listId = (i: number) => `thread-books-${i}`;
---

<div class="threads">
  {
    threads.map((t, i) => (
      <div class="thread">
        <button
          type="button"
          class="thread__row"
          aria-expanded="false"
          aria-controls={listId(i)}
        >
          <span class="thread__name">{t.subject}</span>
          <span class="thread__bar">
            <span class="thread__fill" style={`width:${(t.count / max) * 100}%`} />
          </span>
          <span class="thread__count">{t.count}</span>
          <span class="thread__caret" aria-hidden="true">▸</span>
        </button>
        <ul class="thread__books" id={listId(i)} hidden>
          {t.books.map((b) => {
            const out = b.href && b.external
              ? { rel: "nofollow noopener", target: "_blank" }
              : {};
            return (
              <li class="tbook">
                {b.href ? (
                  <a href={b.href} class="tbook__cover" {...out}>
                    <BookCover cover={b.cover} title={b.title} author={b.author} width={34} />
                  </a>
                ) : (
                  <span class="tbook__cover">
                    <BookCover cover={b.cover} title={b.title} author={b.author} width={34} />
                  </span>
                )}
                <span class="tbook__meta">
                  {b.href ? (
                    <a href={b.href} class="tbook__title" {...out}>
                      {b.title}
                    </a>
                  ) : (
                    <span class="tbook__title">{b.title}</span>
                  )}
                  <span class="tbook__author">{b.author}</span>
                </span>
                {b.rating > 0 ? (
                  <StarRating rating={b.rating} size="0.7rem" />
                ) : (
                  <span class="tbook__unrated">—</span>
                )}
              </li>
            );
          })}
        </ul>
      </div>
    ))
  }
</div>

<script>
  for (const btn of document.querySelectorAll<HTMLButtonElement>(".thread__row")) {
    btn.addEventListener("click", () => {
      const id = btn.getAttribute("aria-controls");
      const list = id ? document.getElementById(id) : null;
      if (!list) return;
      const open = btn.getAttribute("aria-expanded") === "true";
      btn.setAttribute("aria-expanded", String(!open));
      list.hidden = open;
    });
  }
</script>

<style>
  .threads {
    margin-top: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  /* bar row — a button, reset to look like the chart rows it replaces */
  .thread__row {
    display: grid;
    grid-template-columns: 12em 1fr 2.5em 1em;
    align-items: center;
    gap: var(--space-3);
    width: 100%;
    padding: 0;
    background: none;
    border: 0;
    font: inherit;
    color: inherit;
    text-align: left;
    cursor: pointer;
  }
  .thread__name {
    font-size: var(--text-sm);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .thread__bar {
    background: var(--color-faint);
    border-radius: 999px;
    height: 12px;
    overflow: hidden;
  }
  .thread__fill {
    display: block;
    height: 100%;
    background: var(--color-night);
    border-radius: 999px;
  }
  .thread__count {
    font-size: var(--text-sm);
    color: var(--color-muted);
    text-align: right;
  }
  .thread__caret {
    font-size: 0.7em;
    color: var(--color-muted);
    transition: transform var(--transition);
    display: inline-block;
  }
  .thread__row:hover .thread__name,
  .thread__row:focus-visible .thread__name {
    color: var(--color-accent);
  }
  .thread__row:hover .thread__fill {
    filter: brightness(1.12);
  }
  .thread__row:hover .thread__caret {
    color: var(--color-accent);
  }
  .thread__row[aria-expanded="true"] .thread__caret {
    transform: rotate(90deg);
  }

  /* the books behind a bar */
  .thread__books {
    list-style: none;
    margin: var(--space-3) 0 var(--space-2);
    padding: 0 0 0 var(--space-4);
    border-left: var(--hairline);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .thread__books[hidden] {
    display: none;
  }
  .tbook {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-3);
  }
  .tbook__cover {
    display: block;
  }
  .tbook__meta {
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
  }
  .tbook__title {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-ink);
    line-height: var(--leading-snug);
  }
  a.tbook__title:hover {
    color: var(--color-accent);
    text-decoration: none;
  }
  .tbook__author {
    font-size: var(--text-xs);
    color: var(--color-muted);
  }
  .tbook__unrated {
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  @media (max-width: 32rem) {
    .thread__row {
      grid-template-columns: 8em 1fr 2em 1em;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .thread__caret {
      transition: none;
    }
  }
</style>
